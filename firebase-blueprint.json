        "update": "request.auth != null",
        "delete": "request.auth != null"
      },
      "fields": {
        "title": "string",
        "origin": "string",
        "year": "string",
        "mileage": "string",
        "price": "string",
        "pixelId": "string",
        "description": "string",
        "images": "array",
        "status": "string",
        "createdAt": "timestamp"
      }
    }
  }
}
